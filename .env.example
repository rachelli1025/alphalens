# Copy to .env and fill in. Never commit .env.

# --- Postgres (local docker-compose) ---
POSTGRES_USER=alphalens
POSTGRES_PASSWORD=alphalens
POSTGRES_DB=alphalens
# App DB URL (psycopg3 driver; used for both sync and async)
DATABASE_URL=postgresql+psycopg://alphalens:alphalens@localhost:5432/alphalens

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI providers (needed from W1 step 4) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Answers (DESIGN.md D7) ---
ANSWER_MODEL=claude-haiku-5-5
ANSWER_EFFORT=medium
# Rerank hybrid-search candidates before answering (true/false).
RERANK_ENABLED=true

# --- API access ---
# Required header X-Access-Key for /api/ask. Leave empty locally; always set when deployed.
ACCESS_KEY=
# Comma-separated browser origins allowed to call the API (add the Vercel URL when deployed).
CORS_ORIGINS=http://localhost:3000

# --- SEC EDGAR: required User-Agent, format "<name> <email>" ---
SEC_USER_AGENT=

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
